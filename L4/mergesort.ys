#
# Calling conventions:
#     %rdi, %rsi, %rdx, %rcx, %r8, %r9, %r10, %r11 and %rax are caller saved
#     %rbx, %rbp, %r12, %r13, %r14 are callee saved
#     %rsp can not be used except for its normal use as a stack pointer.
#     argument are passed through registers %rdi, %rsi, %rdx in this order.
#     values are returned through %rax

.pos 0x100

main:	irmovq bottom,  %rsp     # initialize stack
	# TODO: TESTING REMOVE, CALLEE REG PRESERVATION
	irmovq $0x99, %rbx
	irmovq $0x99, %rbp
	irmovq $0x99, %r12
	irmovq $0x99, %r13
	irmovq $0x99, %r14

	irmovq array, %rdi       # %rdi = pointer to first element of the array
	xorq   %rax, %rax        # %rsi = size
	mrmovq size(%rax), %rsi
	irmovq $1, %rax          # %rsi = size - 1
	subq   %rax, %rsi
	addq   %rsi, %rsi        # %rsi = 8 * (size - 1)
	addq   %rsi, %rsi
	addq   %rsi, %rsi
	addq   %rdi, %rsi        # %rsi = pointer to last element of the array.
	call   mergesort
	halt

#
# Mergesort
#    %rdi: pointer to the first element of the range to sort.
#    %rsi: pointer to the last element of the range to sort.
#
mergesort:
	irmovq $40, %rax
    rrmovq %rsi, %rcx
	# rbx, rbp used by merge
	# r14 reserved for 8
	rmmovq %rbx, -8(%rsp)
	rmmovq %rbp, -16(%rsp)
	rmmovq %r12, -24(%rsp)
	rmmovq %r13, -32(%rsp)
	rmmovq %r14, -40(%rsp)
	subq %rax, %rsp
    subq %rdi, %rcx
	irmovq $8, %r14
	irmovq $24, %r13
	irmovq $2, %r12
    irmovq $-8, %rbx
	call mergesorthelper
	irmovq $40, %rax
	mrmovq 0(%rsp), %r14
	mrmovq 8(%rsp), %r13
	mrmovq 16(%rsp), %r12
	mrmovq 24(%rsp), %rbp
	mrmovq 32(%rsp), %rbx
	addq %rax, %rsp
	ret
mergesorthelper:	
	jle    done             # if not, done.
    
    subq %r13, %rsp

    rrmovq %rdi, %rdx       # %rdx = mid. Note the use  of ANDQ.
    rmmovq %rdi, 16(%rsp)
	addq   %rsi, %rdx       # Since we're doing arithmetic  with
    rmmovq %rsi, 8(%rsp)
	divq   %r12, %rdx       # integer division to ensure  we get
	andq   %rbx, %rdx       
    rrmovq %rdx, %rcx
    subq %rdi, %rcx

    rmmovq %rdx, 0(%rsp)
    rrmovq %rdx, %rsi      
	call   mergesorthelper

	mrmovq 0(%rsp), %rdi
	mrmovq 8(%rsp), %rsi
    addq   %r14, %rdi
	rrmovq %rsi, %rcx
    subq %rdi, %rcx

	call   mergesorthelper

	mrmovq 0(%rsp), %rdx
	mrmovq 8(%rsp), %rsi
	mrmovq 16(%rsp), %rdi
	addq %r13, %rsp


#
# Merge
#    %rdi: pointer to the first element of the range to merge.
#    %rsi: pointer to the last element of the range to merge.
#    %rdx: pointer to the middle element of the range to merge.
#
# %rdi is i
# %rcx is j
# %rdx is mid
# %rsi is last
# %rbp is dest

merge:
	rrmovq %rdx, %rcx
    irmovq temp, %rbp
    rrmovq %rdi, %r8
	addq   %r14, %rcx
	
    
mergeloop1:	
	rrmovq %rdx, %rax          # while (i <= mid && j <= last)
	subq   %r8, %rax
    mrmovq 0(%rcx), %r10   	   # %ebx = A[j]
	rrmovq %rsi, %rax
	jl     mergeloop2
	
	
	subq   %rcx, %rax
	mrmovq 0(%r8), %rax       # %rax = A[i]
	
	jl     mergeloop2

	
	
	subq   %rax, %r10          # if A[i] <= A[j]
	jl     mergecopy2

	rmmovq %rax, 0(%rbp)       # copy A[i] to temp
	addq   %r14, %rbp
	addq   %r14, %r8
	jmp    mergeloop1

mergecopy2:
	mrmovq 0(%rcx), %r10       # %ebx = A[j] again
	rmmovq %r10, 0(%rbp)
	addq   %r14, %rbp
	addq   %r14, %rcx
	jmp    mergeloop1

mergeloop2:
	# TODO: Copy inline v2
	# inlining (rdi: r9 , rsi: r10, rdx: r11, rax: rbp)
	rrmovq %r8, %r9
	rrmovq %rdx, %r10
	rrmovq %rbp, %r11
	jmp copy1
copycontinue1:
	
	rmmovq %rbp, 0(%r11)
	addq   %r14, %r11
	addq   %r14, %r9
copy1:	
	rrmovq %r10, %rbp
	subq   %r9, %rbp
	mrmovq 0(%r9), %rbp
	jge     copycontinue1

	# TODO: Copy inline v2
	# inlining (rdi: r9 , rsi: r10, rdx: r11, rax: rbp)
	rrmovq %rcx, %r9
	rrmovq %rsi, %r10
	jmp copy2
copycontinue2:
	rmmovq %rax, 0(%r11)
	addq   %r14, %r11
	addq   %r14, %r9
copy2:	
	rrmovq %r10, %rax
	subq   %r9, %rax
	mrmovq 0(%r9), %rax
	jge     copycontinue2
	
	rrmovq %rdi, %rax
	
	rrmovq %rsi, %r10
	subq %rax, %r10
	rrmovq %rax, %r11
	irmovq temp, %r9
	addq %r9, %r10
	jmp copy3
copycontinue3:
	rmmovq %rax, 0(%r11)
	addq   %r14, %r11
	addq   %r14, %r9
copy3:	
	rrmovq %r10, %rax
	subq   %r9, %rax
	mrmovq 0(%r9), %rax
	jge     copycontinue3
	ret

done:	ret


#
# Array to sort
#
.pos 0x1000
array:
		.quad	0xdb57b
	.quad	0x49292
	.quad	0x6e13d
	.quad	0x7858b
	.quad	0x8ccac
	.quad	0x4a921
	.quad	0x9447f
	.quad	0xf147b
	.quad	0xbbc63
	.quad	0x3d403
	.quad	0x444f0
	.quad	0xbe9c3
	.quad	0xeb1d7

#
# Temporary array.
#
.pos 0x2000
temp:   .quad 0,13


#	
# Array size.
#	
size:   .quad 13
	
#
# Stack (32 sixty-four bit words is more than enough here).
#
.pos 0x3000
top:	            .quad 0x00000000,0x20     # top of stack.
bottom:             .quad 0x00000000          # bottom of stack.

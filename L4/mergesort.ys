#
# Calling conventions:
#     %rdi, %rsi, %rdx, %rcx, %r8, %r9, %r10, %r11 and %rax are caller saved
#     %rbx, %rbp, %r12, %r13, %r14 are callee saved
#     %rsp can not be used except for its normal use as a stack pointer.
#     argument are passed through registers %rdi, %rsi, %rdx in this order.
#     values are returned through %rax

.pos 0x100

main:	irmovq bottom,  %rsp     # initialize stack
	# TODO: TESTING REMOVE, CALLEE REG PRESERVATION
	irmovq $0x99, %rbx
	irmovq $0x99, %rbp
	irmovq $0x99, %r12
	irmovq $0x99, %r13
	irmovq $0x99, %r14

	irmovq array, %rdi       # %rdi = pointer to first element of the array
	xorq   %rax, %rax        # %rsi = size
	mrmovq size(%rax), %rsi
	irmovq $1, %rax          # %rsi = size - 1
	subq   %rax, %rsi
	addq   %rsi, %rsi        # %rsi = 8 * (size - 1)
	addq   %rsi, %rsi
	addq   %rsi, %rsi
	addq   %rdi, %rsi        # %rsi = pointer to last element of the array.
	call   mergesort
	halt

#
# Mergesort
#    %rdi: pointer to the first element of the range to sort.
#    %rsi: pointer to the last element of the range to sort.
#
mergesort:
	irmovq $40, %rax
	# rbx, rbp used by merge
	# r14 reserved for 8
	rmmovq %rbx, -8(%rsp)
	rmmovq %rbp, -16(%rsp)
	rmmovq %r12, -24(%rsp)
	rmmovq %r13, -32(%rsp)
	rmmovq %r14, -40(%rsp)
	subq %rax, %rsp
	irmovq $8, %r14
	irmovq $24, %r13
	irmovq $2, %r12
	call mergesorthelper
	irmovq $40, %rax
	mrmovq 0(%rsp), %r14
	mrmovq 8(%rsp), %r13
	mrmovq 16(%rsp), %r12
	mrmovq 24(%rsp), %rbp
	mrmovq 32(%rsp), %rbx
	addq %rax, %rsp
	ret
mergesorthelper:
	rrmovq %rsi, %rax  	    # is first < last ?
	subq   %rdi, %rax
	rrmovq %rdi, %rdx       # %rdx = mid. Note the use  of ANDQ.
	jle    done             # if not, done.

	
	addq   %rsi, %rdx       # Since we're doing arithmetic  with
	
	divq   %r12, %rdx       # integer division to ensure  we get
	irmovq $-8,  %rax       # a valid pointer.
	andq   %rax, %rdx       

	rmmovq %rdi, -8(%rsp)
	rmmovq %rsi, -16(%rsp)
	rmmovq %rdx, -24(%rsp)
	subq %r13 , %rsp         
	rrmovq %rdx, %rsi       

	call   mergesorthelper

	mrmovq 0(%rsp), %rdx
	mrmovq 8(%rsp), %rsi
	mrmovq 16(%rsp), %rdi
	addq %r13, %rsp
	
	rmmovq %rdi, -8(%rsp)
	rmmovq %rsi, -16(%rsp)
	rmmovq %rdx, -24(%rsp)
	subq %r13 , %rsp    

	rrmovq %rdx, %rdi
	
	addq   %r14, %rdi
	call   mergesorthelper
	mrmovq 0(%rsp), %rdx
	mrmovq 8(%rsp), %rsi
	mrmovq 16(%rsp), %rdi
	addq %r13, %rsp

    pushq %rdi
    pushq %r12
	call   merge  
	popq %r12
	popq %rdi

done:	ret

#
# Merge
#    %rdi: pointer to the first element of the range to merge.
#    %rsi: pointer to the last element of the range to merge.
#    %rdx: pointer to the middle element of the range to merge.
#


# TODO: %rcx, %r8, %r9, %r10, %r11, %rax and are available

merge:
	irmovq temp, %rcx

	rrmovq %rdi, %r8 # r8 = ptr

	# copy into temp
	jmp tempcopy
tempcopycont:
	mrmovq (%r8), %r10
	rmmovq %r10, (%rcx)
	addq %r14, %rcx
	addq %r14, %r8
tempcopy:
	rrmovq %r8, %r9
	subq %rsi, %r9
	jle tempcopycont
	
	irmovq temp, %rcx # rcx = L

	rrmovq %r14, %r8 # r8 = n1
	addq %rdx, %r8
	subq %rdi, %r8
	addq %rcx, %r8 
    rrmovq %r8, %r11 # r11 = R

	rrmovq %rsi, %r9 # r9 = n2
	subq %rdx, %r9
	addq %r8, %r9 

    # rdi is arr

loopstart1:
    rrmovq %rcx, %r10 # r10 = L
    subq %r8, %r10 # L - n1
    je done1
    rrmovq %r11, %r10 # r10 = R
    subq %r9, %r10 # R - n2
    je done1
    mrmovq (%rcx), %r10 # L[i]
    mrmovq (%r11), %rax # R[i]
    rrmovq %r10, %r12
    subq %rax, %r12 # L[i] - R[i]
    jg Rsmaller
# otherwise L is smaller
    rmmovq %r10, (%rdi)
    addq %r14, %rcx
    addq %r14, %rdi
    jmp loopstart1
Rsmaller:
    rmmovq %rax, (%rdi)
    addq %r14, %r11
    addq %r14, %rdi
    jmp loopstart1
done1:
lloop:
    rrmovq %rcx, %r10
    subq %r8, %r10
    je done2
    # otherwise need to transfer remaining
    mrmovq (%rcx), %r10
    rmmovq %r10, (%rdi)
    addq %r14, %rdi
    addq %r14, %rcx
    jmp lloop
done2:
rloop:
    rrmovq %r11, %r10
    subq %r9, %r10
    je done3
    # otherwise need to transfer remaining
    mrmovq (%r11), %r10
    rmmovq %r10, (%rdi)
    addq %r14, %rdi
    addq %r14, %r11
    jmp rloop
done3:
	ret


#
# Array to sort
#
.pos 0x1000
array:
		.quad	0xdb57b
	.quad	0x49292
	.quad	0x6e13d
	.quad	0x7858b
	.quad	0x8ccac
	.quad	0x4a921
	.quad	0x9447f
	.quad	0xf147b
	.quad	0xbbc63
	.quad	0x3d403
	.quad	0x444f0
	.quad	0xbe9c3
	.quad	0xeb1d7

#
# Temporary array.
#
.pos 0x2000
temp:   .quad 0,13


#	
# Array size.
#	
size:   .quad 13
	
#
# Stack (32 sixty-four bit words is more than enough here).
#
.pos 0x3000
top:	            .quad 0x00000000,0x20     # top of stack.
bottom:             .quad 0x00000000          # bottom of stack.

